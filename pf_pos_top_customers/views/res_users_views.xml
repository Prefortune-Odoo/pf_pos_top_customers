<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_pos_top_customers" model="ir.ui.view">
        <field name="name">res.users.form.inherit.pos.top.customers</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//group" position="inside">
                <group string="POS Top Customers Access" name="pos_top_customers_access">
                    <field name="enable_pos_top_customer_report_access"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
